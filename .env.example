# Servidor
NODE_ENV=production
PORT=3000
# Claves de API separadas por comas. El navegador envia la misma en X-API-Key.
# Si queda vacio en produccion, las rutas privadas (/sourcing, /alerts, /suppliers)
# responden 503 para no quedar abiertas.
API_KEYS=
# Origenes permitidos por CORS, separados por comas. No uses "*" en produccion.
ALLOWED_ORIGINS=https://tools.bruneagroup.com
# Limite de peticiones por minuto y clave/IP (0 = sin limite).
RATE_LIMIT_PER_MIN=60
# Beacon de diagnostico: peticiones/minuto, tamano maximo y lineas por envio.
BEACON_RATE_PER_MIN=30
BEACON_MAX_BYTES=16384
BEACON_MAX_LINES=25

# Cifrado de tokens en el servidor. Genera una con: openssl rand -hex 32
VAULT_KEY=

# Mercado Amazon ES (no cambiar salvo que vendas en otro marketplace)
MARKETPLACE_ID=A1RKKUPIHCS9HS
SPAPI_REGION=eu-west-1

# --- Amazon Selling Partner API (SP-API) ---
# App de desarrollador creada en Seller Central > Apps y servicios > Desarrollar apps
LWA_CLIENT_ID=
LWA_CLIENT_SECRET=
# Refresh token obtenido en la autorizacion OAuth de tu propia cuenta
SPAPI_REFRESH_TOKEN=
# Selling Partner ID (Seller ID) de tu cuenta
SPAPI_SELLER_ID=
# Credenciales IAM de AWS (necesarias para firmar las peticiones, SigV4)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: si usas un rol IAM en lugar de claves directas
SPAPI_ROLE_ARN=

# --- Keepa (de pago, por tokens). Imprescindible para el BSR ---
KEEPA_API_KEY=
# 1=US 2=UK 3=DE 4=FR 5=JP 6=CA 8=IT 9=ES 10=IN 11=MX
KEEPA_DOMAIN=9

# --- Fuentes por feed/CSV (opcional, la via mas limpia) ---
FEED_OUTLETPC=
FEED_LIDL=
FEED_IHERB=

# --- Proveedor de scraping (opcional): scraperapi | brightdata | none ---
SCRAPER_PROVIDER=none
SCRAPER_API_KEY=

# --- Descubrimiento de proveedores por buscador (recomendado) ---
# --- APIFY (CORE, clave unica): descubrimiento, 1688, Alibaba, Made-in-China,
# Google Shopping y contraste de fotos. Solo en Railway Variables. ---
APIFY_TOKEN=
APIFY_COUNTRY=es
APIFY_CACHE_MIN=720
APIFY_MAX_COST_PER_OP=0.50
APIFY_TIMEOUT_SEC=50
APIFY_SEARCH_ACTOR=apify/google-search-scraper
APIFY_CRAWL_ACTOR=apify/website-content-crawler
APIFY_IMAGE_ACTOR=devcake/scraper-by-image
APIFY_1688_ACTOR=datacach/1688-search-scraper
APIFY_ALIBABA_ACTOR=happitap/alibaba-product-scraper
APIFY_MIC_ACTOR=agenscrape/made-in-china-com-product-scraper
APIFY_SHOPPING_ACTOR=automation-lab/google-shopping-scraper
APIFY_SHOPPING_EAN_ACTOR=scrapewise/google-shopping
APIFY_ALIEXPRESS_ACTOR=
# (Opcional) Brave Search API, respaldo del descubrimiento: https://brave.com/search/api/  (~5 EUR / 1000 busquedas,
# con 5 EUR de credito gratis al mes). Es la pieza que descubre paginas de
# mayoristas/distribuidores por EAN o marca+modelo, sin depender de webs fijas.
BRAVE_API_KEY=
# Sin APIFY_TOKEN ni BRAVE_API_KEY el descubrimiento sigue abierto con
# DuckDuckGo/Bing del lado del servidor (respaldo sin claves).
DISCOVERY_PROVIDER=brave
DISCOVERY_COUNTRY=es
DISCOVERY_LANG=es

# --- Fabricante / distribuidor / mayorista por EAN (v0.29) ---
# Replica la busqueda manual: Google -> "<EAN>" mayorista / distribuidor /
# al por mayor y "<marca>" distribuidor oficial. Clasifica cada web por su papel
# y aparta las tiendas minoristas. Usa APIFY_TOKEN (Google) o BRAVE_API_KEY;
# sin ninguno cae a DuckDuckGo/Bing desde el servidor (suelen bloquearlo).
LEADS_ENABLED=1
# Consultas por busqueda (2-14) y resultados por consulta (5-20).
LEADS_MAX_QUERIES=10
LEADS_PER_QUERY=10
# Paginas que se abren para confirmar EAN, senales B2B y contacto (0-20).
LEADS_PAGE_CHECKS=8
LEADS_PAGE_MS=8000
LEADS_TIMEOUT_MS=90000

# --- Busqueda de proveedores (Fase 2) ---
# Resultados utiles por fuente y tope global (3-40).
SUPPLIER_MAX_RESULTS=20
SUPPLIER_MAX_RESULTS_CAP=40
# Consultas de la cascada por fuente gratuita y por fuente de pago (Apify).
# Maximo global de la cascada: 5 (el plan siempre reserva marca+titulo).
SUPPLIER_MAX_QUERIES=4
SUPPLIER_MAX_QUERIES_PAID=2
# Con estos resultados utiles ya no se prueba la siguiente consulta.
SUPPLIER_ENOUGH=5

# --- Fase 4 · puntuacion de coincidencia 0-100 ---
# Fichas de proveedor que se abren para leer JSON-LD/Open Graph: gtin/mpn/sku,
# precio, foto, descripcion, color, talla, material, peso y caracteristicas.
# 0 = no enriquecer. Maximo por busqueda (0-60). El modo EAN exacto usa al
# menos 24 porque casi ninguna fuente publica el EAN en el resultado de busqueda.
MATCH_ENRICH_MAX=40
# Timeout por ficha en milisegundos (1000-20000).
MATCH_ENRICH_MS=9000
# Fotos de candidatos que se contrastan (0-20) y timeout por foto (1000-15000).
# Compara URL/huella/proporcion; con vision ademas compara el contenido.
MATCH_IMAGE_MAX=8
MATCH_IMAGE_MS=5000

# --- Comparacion visual de fotos (OPCIONAL) ---
# Sin clave se usan las heuristicas y el resultado queda "sin confirmar
# visualmente". Proveedor: anthropic | openai | gemini | openrouter.
IMAGE_AI_ENABLED=true
IMAGE_AI_PROVIDER=anthropic
# Llamadas de vision por busqueda (0 = no llamar).
IMAGE_AI_MAX=10
IMAGE_AI_TIMEOUT_MS=12000
# Minutos de cache por par de URLs (0 = sin cache).
IMAGE_AI_CACHE_MIN=1440
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Alternativas (solo se usa la del proveedor activo):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Fase 5 · tarifas reales y restricciones (SP-API) ---
# Reintentos ante 429/5xx y espera base en ms (crece de forma exponencial).
SPAPI_MAX_RETRIES=3
SPAPI_RETRY_MS=600
# Candidatos por busqueda a los que se piden tarifas si Keepa no las trae (0-20).
SPAPI_FEES_MAX=8
# Candidatos por busqueda a los que se consultan restricciones de listado (0-20).
SPAPI_RESTRICTIONS_MAX=8

# --- Regla Buy Box 90 d ---
# Vendedores cuyo nombre se consulta en Keepa por candidato (0 = no consultar).
BB_SELLER_LOOKUPS=3
# No apto si Amazon + fabricante alcanzan este % de la Buy Box.
BB_MANUFACTURER_MIN=95
# No apto si los terceros se quedan por debajo de este %.
BB_THIRD_MAX=5
# Un unico tercero con este % o mas: "a revisar", nunca descarte automatico.
BB_SINGLE_THIRD=97

# --- Proveedores/marketplaces con API (clave por tienda) ---
# BigBuy (mayorista, Valencia): pide la API en https://www.bigbuy.eu/en/api_bigbuy.html
BIGBUY_API_KEY=
BIGBUY_BASE=https://api.bigbuy.eu
BIGBUY_ISO=es
# Paginas del catalogo a descargar en el snapshot y minutos de cache.
BIGBUY_MAX_PAGES=4
BIGBUY_CACHE_MIN=30

# --- Icecat (ficha de producto por EAN) ---
# Recomendado: tokens de My Icecat > Access Tokens. Van en las cabeceras
# api-token y content-token; no necesitan IP permitida ni contrasena.
ICECAT_API_TOKEN=
ICECAT_CONTENT_TOKEN=
# Opcional: solo si tu cuenta lo exige ademas del token.
ICECAT_SHOPNAME=
# Legado: usuario y contrasena (HTTP Basic). Requiere IP de salida autorizada.
ICECAT_USERNAME=
ICECAT_PASSWORD=
ICECAT_BASE=https://live.icecat.biz
ICECAT_LANG=es

# AliExpress Open Platform (app de desarrollador con la API de afiliado/dropshipping)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_SESSION=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_BASE=https://api-sg.aliexpress.com/sync

# CJdropshipping: API key en https://developers.cjdropshipping.com
CJ_API_KEY=
CJ_BASE=https://developers.cjdropshipping.com/api2.0/v1

# --- Codigo de barras -> producto (nombre/marca) ---
# upcitemdb (funciona sin clave en modo trial) | ean-search (requiere token)
BARCODE_PROVIDER=upcitemdb
UPCITEMDB_API_KEY=

# --- Vigilante de precios (alertas) ---
# Cadena de conexion de Postgres. En Railway: servicio Postgres -> Variables -> DATABASE_URL.
# Si se deja vacia, la herramienta guarda los avisos en un fichero JSON local (backend/data/alerts.json).
DATABASE_URL=
# Activado por defecto. Pon false para desactivar el vigilante.
ALERTS_ENABLED=true
# Horas entre revisiones de precio (por defecto 12).
ALERT_INTERVAL_HOURS=12
# Umbral de bajada por defecto en % (por defecto 5). Cada producto puede ajustarlo.
ALERT_TARGET_PCT=5
# Ruta del fichero de respaldo cuando no hay DATABASE_URL.
ALERTS_DATA_FILE=

# --- Barrido diario del catalogo (paso 1: altas nuevas y bajadas, sin palabra clave) ---
# Activado por defecto. Pon false para desactivarlo.
CATALOG_SWEEP_ENABLED=true
# Horas entre barridos del catalogo (por defecto 24 = una vez al dia).
CATALOG_SWEEP_INTERVAL_HOURS=24
# Bajada de precio minima para avisar en el barrido, en % (por defecto 10).
CATALOG_SWEEP_DROP_PCT=10
# Productos a revisar por fuente y barrido (1-60, por defecto 40).
CATALOG_SWEEP_MAX=40
# Fuentes con accion browse (por defecto outletpc,lidl).
CATALOG_SWEEP_SOURCES=outletpc,lidl
